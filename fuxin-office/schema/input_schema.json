{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fuxin.example.com/skills/fuxin-office-suite/schema/input_schema.json",
  "title": "fuxin-office-suite 入参 Schema",
  "description": "福昕 Office 全家桶技能套件（对外仅暴露 fuxin-office 一个技能）的入参校验定义。套件入口为 fuxin-office（唯一入口/汇总层），主要输入为自然语言任务描述，由路由层解析到目标能力域与类型；skills 枚举中的 fuxin-word / fuxin-excel 等为网关侧路由目标标识（对应 fuxin-office 内部参考文档 reference/*.md）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "office.task",
        "office.e2e",
        "office.preflight",
        "office.qa",
        "office.batch"
      ],
      "description": "任务类型。office.task=单产品意图路由；office.e2e=跨产品/多步骤 E2E 分步编排；office.preflight=预检；office.qa=文档只读问答；office.batch=批次管理。"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "description": "用户自然语言任务描述，例如：写一份季度报告；把 A 列为空的行高亮标红。"
    },
    "target": {
      "type": "object",
      "description": "路由目标结构。由路由层根据触发词解析填写，执行时可校验。",
      "properties": {
        "skill": {
          "type": "string",
          "enum": [
            "fuxin-office",
            "fuxin-office-bridge",
            "fuxin-word",
            "fuxin-excel",
            "fuxin-ppt",
            "fuxin-doc-qa",
            "fuxin-batch-undo",
            "fuxin-custom-tool"
          ],
          "description": "路由目标标识。fuxin-office=本技能（入口）；其余为网关侧能力域标识（对应 reference/*.md 内部参考文档），不作为独立技能对外暴露。"
        },
        "tool": {
          "type": "string",
          "description": "场景工具，例如 write_report / generate_deck / extract_data_to_new_sheet / highlight_by_condition / checklist_review 等。"
        },
        "product": {
          "type": "string",
          "enum": ["Word", "Excel", "PowerPoint"],
          "description": "目标产品分类（网关产品注册名）。"
        }
      },
      "additionalProperties": false,
      "required": ["skill"]
    },
    "preflight": {
      "type": "boolean",
      "description": "是否在执行前运行 fuxin-office-bridge 5 层预检（写操作前建议为 true）。"
    },
    "batch": {
      "type": "boolean",
      "description": "多步骤写操作是否需要整体撤销（归入同一批次，一次 Ctrl+Z 撤销）。"
    },
    "confirm": {
      "type": "boolean",
      "description": "写操作执行前的用户确认开关（危险操作强制要求确认）。"
    },
    "readonly": {
      "type": "boolean",
      "description": "仅只读问答场景（office.qa）使用，强制不改写文档。"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "E2E 分步编排的步骤列表（type=office.e2e 时使用）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "object",
            "description": "单步的路由目标结构。",
            "properties": {
              "skill": {
                "type": "string",
                "enum": [
                  "fuxin-office",
                  "fuxin-office-bridge",
                  "fuxin-word",
                  "fuxin-excel",
                  "fuxin-ppt",
                  "fuxin-doc-qa",
                  "fuxin-batch-undo",
                  "fuxin-custom-tool"
                ],
                "description": "路由到的技能名称。"
              },
              "tool": {
                "type": "string",
                "description": "场景技能工具，例如 write_report / generate_deck / extract_data_to_new_sheet 等。"
              },
              "product": {
                "type": "string",
                "enum": ["Word", "Excel", "PowerPoint"],
                "description": "目标产品分类。"
              }
            },
            "additionalProperties": false,
            "required": ["skill"]
          },
          "preflight": {
            "type": "boolean",
            "description": "本步骤是否执行预检。"
          },
          "confirm": {
            "type": "boolean",
            "description": "本步骤写操作是否需用户确认。"
          }
        },
        "required": ["target"]
      }
    }
  }
}